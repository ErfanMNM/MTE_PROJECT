<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CodePlus.ViewModels"
             xmlns:models="clr-namespace:CodePlus.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="CodePlus.Views.SnippetsView"
             x:DataType="vm:SnippetsViewModel">

    <Design.DataContext>
        <vm:SnippetsViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Snippets" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Reusable code blocks across languages." Opacity="0.7" />
            </StackPanel>
            <Button Grid.Column="1" Content="+ New snippet"
                    Padding="18,10" CornerRadius="14"
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Snippets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:Snippet">
                        <Border Margin="0,0,0,12" Padding="18" CornerRadius="20"
                                Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel Spacing="8">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Padding="10,4" CornerRadius="999"
                                            Background="{DynamicResource SecondaryHueLight}">
                                        <TextBlock Text="{Binding Language}" FontSize="11" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                                </DockPanel>
                                <Border CornerRadius="12" Padding="12"
                                        Background="{DynamicResource MaterialDesignTextFieldBoxBackground}">
                                    <TextBlock Text="{Binding Code}"
                                               FontFamily="Consolas,Menlo,monospace"
                                               FontSize="12" TextWrapping="Wrap" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,3" CornerRadius="999"
                                                    Background="{DynamicResource MaterialDesignChipBackground}">
                                                <TextBlock Text="{Binding}" FontSize="10" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
