<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CodePlus.ViewModels"
             xmlns:models="clr-namespace:CodePlus.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="CodePlus.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">

    <Design.DataContext>
        <vm:ProjectsViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
            <TextBlock Text="Projects" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="Manage your repositories with expressive Material 3 cards."
                       Opacity="0.7" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:ProjectSummary">
                        <Border Margin="0,0,12,12" Padding="20" CornerRadius="24"
                                Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel Spacing="12">
                                <Border Width="40" Height="40" CornerRadius="14"
                                        Background="{DynamicResource TertiaryHueMidBrush}">
                                    <TextBlock Text="{Binding Language[0]}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TertiaryHueMidForegroundBrush}" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.7" />
                                <ProgressBar Value="{Binding Progress}" Maximum="1" Height="6" CornerRadius="3"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Padding="8,3" CornerRadius="999"
                                            Background="{DynamicResource PrimaryHueLight}">
                                        <TextBlock Text="{Binding Language}" FontSize="10" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
