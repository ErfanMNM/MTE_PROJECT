<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodePlus.ViewModels"
        xmlns:views="using:CodePlus.Views"
        xmlns:models="clr-namespace:CodePlus.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="CodePlus.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="820"
        MinWidth="980" MinHeight="640"
        Title="CodePlus"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.nav-item">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
        </Style>

        <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
        </Style>

        <Style Selector="Button.nav-item.selected">
            <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}" />
        </Style>

        <Style Selector="Border.expressive-pill">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesignChipBackground}" />
        </Style>
    </Window.Styles>

    <Panel>
        <Border IsHitTestVisible="False"
                Background="{DynamicResource PrimaryHueLightBrush}" />

        <Grid ColumnDefinitions="280,*">
            <!-- ============ SIDEBAR ============ -->
            <Border Grid.Column="0"
                    Padding="20,28,20,20"
                    Background="{DynamicResource MaterialDesignBackground}"
                    CornerRadius="0,32,32,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="6,0,0,28">
                        <Border Width="44" Height="44" CornerRadius="14"
                                Background="{DynamicResource PrimaryHueMidBrush}">
                            <TextBlock Text="C+" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CodePlus" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" />
                            <TextBlock Text="Material 3 Expressive" FontSize="11" Opacity="0.7"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        </StackPanel>
                    </StackPanel>

                    <Border DockPanel.Dock="Top" Margin="0,0,0,20" Padding="14"
                            CornerRadius="20"
                            Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="40" Height="40" CornerRadius="999"
                                    Background="{DynamicResource SecondaryHueMidBrush}">
                                <TextBlock Text="T" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryHueMidForegroundBrush}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Thanh Nguyen" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" />
                                <TextBlock Text="Pro workspace" FontSize="11" Opacity="0.7"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Text="WORKSPACE"
                               Margin="12,4,0,8" FontSize="11" FontWeight="Bold" Opacity="0.7"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />

                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:NavigationItem">
                                <Button Classes="nav-item"
                                        Classes.selected="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectedNavigationItem,
                                            Converter={x:Static ObjectConverters.Equal},
                                            ConverterParameter={Binding}}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectNavigationCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <TextBlock Text="{Binding Icon}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   VerticalAlignment="Center" Width="20" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- ============ MAIN AREA ============ -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <Border Grid.Row="0" Margin="20,20,20,12" Padding="18,12"
                        CornerRadius="24"
                        Background="{DynamicResource MaterialDesignCardBackground}">
                    <DockPanel LastChildFill="True">
                        <StackPanel Orientation="Horizontal" Spacing="10" DockPanel.Dock="Right">
                            <Border Classes="expressive-pill">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="#4CAF50" />
                                    <TextBlock Text="Online" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Button Content="New"
                                    Padding="18,8"
                                    CornerRadius="14"
                                    Background="{DynamicResource PrimaryHueMidBrush}"
                                    Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
                        </StackPanel>

                        <TextBox PlaceholderText="Search projects, snippets, files..."
                                 CornerRadius="16"
                                 Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                 Padding="14,10"
                                 Width="520"
                                 HorizontalAlignment="Left" />
                    </DockPanel>
                </Border>

                <TransitioningContentControl Grid.Row="1" Margin="20,4,20,20"
                                            Content="{Binding CurrentPage}">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.25" />
                    </TransitioningContentControl.PageTransition>

                    <TransitioningContentControl.DataTemplates>
                        <DataTemplate DataType="vm:DashboardViewModel">
                            <views:DashboardView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:ProjectsViewModel">
                            <views:ProjectsView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:SnippetsViewModel">
                            <views:SnippetsView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:AiChatViewModel">
                            <views:AiChatView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:SettingsViewModel">
                            <views:SettingsView />
                        </DataTemplate>
                    </TransitioningContentControl.DataTemplates>
                </TransitioningContentControl>
            </Grid>
        </Grid>
    </Panel>
</Window>
